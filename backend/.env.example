# PostgreSQL database connection string (Neon / Supabase / Local)
DATABASE_URL=postgresql://user:password@localhost:5432/movie_booking

# Admin account email address
ADMIN_EMAIL=your-admin@gmail.com

# Firebase Project ID (for JWT verification)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Razorpay credentials for payment gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Port and Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS in production (e.g. https://cinebook.ansh.one)
FRONTEND_URL=http://localhost:5173
