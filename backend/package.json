{
  "name": "movie-ticket-booking-backend",
  "version": "1.0.0",
  "description": "Express backend for Movie Ticket Booking System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node --dns-result-order=ipv4first dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "razorpay": "^2.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
